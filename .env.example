# SkillHarbor environment (copy to .env or inject via Docker Compose)
# Server binds here; default port is also accepted as: node server.cjs 8900
PORT=8900

# Persistent JSON data directory (users, uploads metadata, secrets, etc.)
DATA_DIR=./data

# Public URL of this portal (used in alerts / installer links)
PORTAL_URL=http://127.0.0.1:8900

# Optional: separate origin that serves user uploads (XSS isolation)
# FILES_BASE=http://127.0.0.1:8180

# One-API / OpenAI-compatible gateway (workbench tokens & quotas)
ONE_API_BASE=http://127.0.0.1:3000
ONE_API_ADMIN_TOKEN=

# Skill Gateway (skills catalog, MCP, optional KB semantic search)
SKILL_GATEWAY_BASE=http://127.0.0.1:8800
SKILL_GATEWAY_TOKEN=
MCP_SERVER_NAME=skillharbor-ai-gateway
MCP_SERVER_URL=http://127.0.0.1:8765/mcp

# Optional MxsDoc knowledge base bridge
MXSDOC_BASE_URL=http://127.0.0.1:8110/DocSystem
MXSDOC_REPOS_ROOT=/var/lib/mxsdoc/repos
KB_BRIDGE_SECRET=
# KB_PERMS=1

# Optional Feishu / Lark alert webhook (also configurable in Admin → Settings)
FEISHU_WEBHOOK_URL=

# Service-tool Docker channel (host docker.sock mounted in container)
# SERVICE_DOCKER=1
